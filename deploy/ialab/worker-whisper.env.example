# worker-whisper — environment variables
# Copy to /etc/ai-platform/worker-whisper.env and fill in real values.
# chmod 600 /etc/ai-platform/worker-whisper.env

# API endpoint on the VPS, reachable from ialab via Tailscale
WORKER_API_URL=http://100.106.192.45:8081

# Worker API key (generated at worker registration — X-Worker-Key)
WORKER_KEY=change_me_worker_key

# Admin key (used only at startup to register the worker — X-Admin-Key)
WORKER_ADMIN_KEY=change_me_admin_key

# Worker ID — stable unique identifier; must match across restarts for idempotent re-registration
WORKER_ID=w-whisper-ialab

# Capabilities advertised to the API (JSON object)
# vram_total_mb: ledger ceiling for the shared GPU (RTX 4070 Ti SUPER, 16376 MiB total).
# This value is upserted into gpus.vram_total_mb at registration — it is the ledger cap
# that prevents over-reservation/OOM. Must match the value the agent/ledger run with (15946).
WORKER_CAPABILITIES={"services": ["transcription"], "cuda": true, "vram_total_mb": 15946}

# Maximum audio file size to download (bytes); default 2 GB
# AUDIO_MAX_SIZE_BYTES=2147483648

# Optional tuning (defaults shown)
# WORKER_HEARTBEAT_INTERVAL=10
# WORKER_POLL_WAIT=30
# WORKER_BACKOFF_MAX=30
