# worker-ollama — environment variables
# Copy to /etc/ai-platform/worker-ollama.env and fill in real values.
# chmod 600 /etc/ai-platform/worker-ollama.env

# API endpoint on the VPS, reachable from ialab via Tailscale
WORKER_API_URL=http://100.106.192.45:8081

# Worker API key (generated at worker registration — X-Worker-Key)
WORKER_KEY=change_me_worker_key

# Admin key (used only at startup to register the worker — X-Admin-Key)
WORKER_ADMIN_KEY=change_me_admin_key

# Worker ID — stable unique identifier; must match across restarts for idempotent re-registration
WORKER_ID=w-ollama-ialab

# Capabilities advertised to the API (JSON object)
# vram_total_mb: same shared GPU as worker-whisper (RTX 4070 Ti SUPER, 16376 MiB total).
# This value is upserted into gpus.vram_total_mb at registration (same gpu_id ialab/gpu-0),
# so it MUST match worker-whisper's value (15946) — it is the ledger cap that prevents OOM.
# min_vram for translation/llm_chat is 5300 MiB (calibrated in T6.6)
WORKER_CAPABILITIES={"services": ["translation", "llm_chat"], "cuda": true, "vram_total_mb": 15946}

# Ollama configuration (match what's in docker-compose.yml)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_IDLE_TIMEOUT=600

# Optional tuning (defaults shown)
# WORKER_HEARTBEAT_INTERVAL=10
# WORKER_POLL_WAIT=30
# WORKER_BACKOFF_MAX=30
