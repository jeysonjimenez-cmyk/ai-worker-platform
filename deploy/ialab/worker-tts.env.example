# worker-tts — environment variables
# Copy to /etc/ai-platform/worker-tts.env and fill in real values.
# chmod 600 /etc/ai-platform/worker-tts.env

# API endpoint on the VPS, reachable from ialab via Tailscale
WORKER_API_URL=http://100.106.192.45:8081

# Worker API key (generated at worker registration — X-Worker-Key)
WORKER_KEY=change_me_worker_key

# Admin key (used only at startup to register the worker — X-Admin-Key)
WORKER_ADMIN_KEY=change_me_admin_key

# Worker ID — stable unique identifier; must match across restarts for idempotent re-registration
WORKER_ID=w-tts-ialab

# Capabilities advertised to the API (JSON object)
# vram_total_mb: same shared GPU as worker-whisper and worker-ollama (RTX 4070 Ti SUPER, 16376 MiB total).
# This value is upserted into gpus.vram_total_mb at registration (gpu_id ialab/gpu-0).
# It MUST match the other workers' value (15946) — it is the ledger cap that prevents OOM.
# A mismatch (e.g. 24564 from an old .example) will be rejected with 409 at registration (T7.1).
WORKER_CAPABILITIES={"services": ["tts"], "cuda": true, "vram_total_mb": 15946}

# TTS engine — Higgs Audio v3 via Docker+SGLang-Omni (aibum-higgs-tts:latest)
# The Higgs container runs as a sidecar alongside this worker.
# See deploy/ialab/docker-compose.yml for the higgs service definition (T7.3).
TTS_HOST=http://127.0.0.1:8002

# Optional tuning (defaults shown)
# WORKER_HEARTBEAT_INTERVAL=10
# WORKER_POLL_WAIT=30
# WORKER_BACKOFF_MAX=30
