# Node Agent — environment variables
# Copy to /etc/ai-platform/agent.env and fill in real values.
# chmod 600 /etc/ai-platform/agent.env  (set by install-agent.sh)

# API endpoint (VPS, reachable via Tailscale)
AGENT_API_URL=http://100.106.192.45:8081

# Worker API key (generated at worker registration — X-Worker-Key)
AGENT_API_KEY=change_me_worker_api_key

# Admin key (used only at startup to register the worker — X-Admin-Key)
AGENT_ADMIN_KEY=change_me_admin_key

# Worker ID — unique identifier for this node
AGENT_WORKER_ID=w-ialab

# Local /metrics bind address — use ialab's Tailscale IP, never 0.0.0.0
# Workers (Docker) query this address; 127.0.0.1 is not reachable from containers.
AGENT_METRICS_BIND=100.103.55.110:9100

# Collection interval in seconds (default: 10)
# AGENT_INTERVAL_SEC=10
